# systemd unit for the broker, for hosts that are not running containers.
#
#   install -d -m 0750 /etc/netbox-openbao-broker/tls
#   install -m 0640 config.toml /etc/netbox-openbao-broker/config.toml
#   install -m 0600 role_id secret_id /etc/netbox-openbao-broker/
#   install -m 0644 netbox-openbao-broker.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now netbox-openbao-broker
#
# The AppRole arrives through LoadCredential rather than Environment=. systemd
# places the material in a per-invocation directory readable only by this
# service, and BROKER_BAO_*_FILE names it from there — so the SecretID never
# appears in /proc/<pid>/environ, in `systemctl show`, or in this file.

[Unit]
Description=netbox-openbao broker
Documentation=https://git.nmulti.cloud/emersonfelipesp/netbox-openbao-broker
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
DynamicUser=yes
ExecStart=/opt/netbox-openbao-broker/venv/bin/netbox-openbao-broker
Restart=on-failure
RestartSec=5s

Environment=BROKER_CONFIG=/etc/netbox-openbao-broker/config.toml
Environment=BROKER_TLS_CERT=/etc/netbox-openbao-broker/tls/server.pem
Environment=BROKER_TLS_KEY=/etc/netbox-openbao-broker/tls/server.key
Environment=BROKER_TLS_CLIENT_CA=/etc/netbox-openbao-broker/tls/client-ca.pem
Environment=BROKER_HOST=127.0.0.1
Environment=BROKER_PORT=8201
Environment=BROKER_LOG_LEVEL=INFO

LoadCredential=role_id:/etc/netbox-openbao-broker/role_id
LoadCredential=secret_id:/etc/netbox-openbao-broker/secret_id
Environment=BROKER_BAO_ROLE_ID_FILE=%d/role_id
Environment=BROKER_BAO_SECRET_ID_FILE=%d/secret_id

# DynamicUser gives an unpredictable UID, so the certificate and config files
# are read through a supplementary group rather than by owner. Create it and
# grant it read on /etc/netbox-openbao-broker.
SupplementaryGroups=netbox-openbao-broker

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# Audit records go to stdout and therefore to the journal, which is where they
# should be shipped from. There is nothing for the service to write itself.
UMask=0077

[Install]
WantedBy=multi-user.target
